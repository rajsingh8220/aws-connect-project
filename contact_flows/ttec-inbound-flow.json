        "Errors": [
          {
            "NextAction": "lookup-error",
            "ErrorType": "NoMatchingError"
          }
        ],
        "Conditions": []
      },
      "Parameters": {
        "Attributes": {
          "accountNumber": "$.StoredCustomerInput"
        }
      }
    },
    {
      "Identifier": "invoke-account-lookup",
      "Type": "InvokeLambdaFunction",
      "Transitions": {
        "NextAction": "save-lookup-results",
        "Errors": [
          {
            "NextAction": "lookup-error",
            "ErrorType": "NoMatchingError"
          }
        ],
        "Conditions": []
      },
      "Parameters": {
        "LambdaFunctionARN": "{{ACCOUNT_LOOKUP_LAMBDA_ARN}}",
        "InvocationTimeLimitSeconds": "8"
      }
    },
    {
