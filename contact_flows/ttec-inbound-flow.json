      "Type": "MessageParticipant",
      "Transitions": {
        "NextAction": "get-account-input",
        "Errors": [],
        "Conditions": []
      },
      "Parameters": {
        "Text": "Welcome to Acme Financial Services. Please enter your account number using your keypad, then press pound."
      }
    },
    {
      "Identifier": "get-account-input",
      "Type": "GetParticipantInput",
      "Transitions": {
