        "Errors": [
          {
            "NextAction": "lookup-error",
            "ErrorType": "NoMatchingError"
          }
        ],
        "Conditions": []
      },
      "Parameters": {
        "Attributes": {
          "lookupSuccess": "$.External.lookupSuccess",
          "firstName": "$.External.firstName",
          "balance": "$.External.balance",
          "accountPhoneNumber": "$.External.phoneNumber"
        }
      }
    },
    {
