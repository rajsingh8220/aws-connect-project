            "ErrorType": "NoMatchingError"
          }
        ],
        "Conditions": []
      },
      "Parameters": {
        "Text": "Enter your account number now.",
        "StoreInput": "True",
        "InputTimeLimitSeconds": "15",
        "InputValidation": {
          "CustomValidation": {
            "MaximumLength": "12"
          }
        }
      }
    },
    {
