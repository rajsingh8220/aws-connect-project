{
  "name": "ttec-connect-project",
  "version": "0.1.0",
  "private": true,
  "description": "TTEC Acme Financial - Amazon Connect contact center",
  "scripts": {
    "build": "tsc -p infra/tsconfig.json",
    "watch": "tsc -w -p infra/tsconfig.json",
    "test": "jest --config infra/jest.config.js",
    "test:lambda": "jest --config infra/jest.config.js --testPathPattern=lambda/",
    "cdk": "cdk --app \"npx ts-node --prefer-ts-exts infra/bin/app.ts\"",
    "synth": "npm run cdk synth",
    "diff": "npm run cdk diff",
    "deploy": "npm run cdk -- deploy TtecConnectStack --require-approval never",
    "deploy:all": "npm run build && npm run test && npm run deploy",
    "deploy:hotswap": "npm run cdk -- deploy TtecConnectStack --hotswap --require-approval never",
    "deploy:lambda": "npm run deploy:hotswap"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "aws-cdk": "2.170.0",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "aws-cdk-lib": "2.170.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  }
}
